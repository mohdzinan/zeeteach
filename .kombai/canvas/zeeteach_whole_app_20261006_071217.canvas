      "html": "<style>\n    @import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Literata:opsz,wght@7..72,400;7..72,500;7..72,600&display=swap');\n.zt-app { --zt-bg:#edf1f2; --zt-paper:#fbfcfb; --zt-paper-alt:#e4ebed; --zt-ink:#152a35; --zt-muted:#526670; --zt-blue:#24566a; --zt-blue-soft:#d8e5e8; --zt-rule:#c5d0d2; --zt-accent:#c45435; --zt-gold:#efc65d; --zt-good:#267259; color:var(--zt-ink); background:var(--zt-bg); font-family:'DM Sans',sans-serif; }\n.zt-display { font-family:'Literata',Georgia,serif; letter-spacing:-.035em; }\n.zt-kicker { font-size:12px; font-weight:700; letter-spacing:.09em; text-transform:uppercase; }\n.zt-focus:focus-visible { outline:3px solid var(--zt-accent); outline-offset:3px; }\n.zt-dark { --zt-bg:#101b21; --zt-paper:#19272f; --zt-paper-alt:#22343e; --zt-ink:#edf2ef; --zt-muted:#b0c0c3; --zt-blue:#92bbc7; --zt-blue-soft:#2a414a; --zt-rule:#40535b; --zt-accent:#f08a65; --zt-gold:#edc867; --zt-good:#83d4ae; }\n@media(max-width:760px){.zt-slide-art{min-height:190px}.zt-slide-copy{padding:24px!important}.zt-nav-label{display:none}.zt-shell{padding-left:18px!important;padding-right:18px!important}.zt-bottom-grid{grid-template-columns:1fr!important}.zt-course-aside{order:2}}\n@media(max-width:440px){.zt-brand-word{font-size:16px!important}.zt-header{gap:8px!important}.zt-header nav{gap:2px!important}.zt-header nav a{padding:9px 7px!important;font-size:12px!important}.zt-theme{width:34px!important;padding:0!important}.zt-lesson-head h1{font-size:32px!important}.zt-slide-copy h2{font-size:29px!important}}\n</style>\n<div class=\"zt-app min-h-screen\" data-kid=\"1\" data-name=\"application container\" style=\"--zt-bg:#edf1f2;--zt-paper:#fbfcfb;--zt-paper-alt:#e4ebed;--zt-ink:#152a35;--zt-muted:#526670;--zt-blue:#24566a;--zt-blue-soft:#d8e5e8;--zt-rule:#c5d0d2;--zt-accent:#c45435;--zt-gold:#efc65d;--zt-good:#267259;\">\n    <header class=\"zt-header border-b border-[var(--zt-rule)] bg-[var(--zt-paper)]\" data-kid=\"1-1\" data-name=\"header section\">\n        <div class=\"zt-shell mx-auto flex min-h-[68px] max-w-[1380px] items-center justify-between gap-4 px-8\" data-kid=\"1-1-1\" data-name=\"header layout shell\">\n            <a aria-label=\"ZeeTeach home\" class=\"zt-focus flex shrink-0 items-center gap-2 no-underline\" data-kid=\"1-1-1-1\" data-name=\"site branding link\" href=\"/\" style=\"color:var(--zt-ink)\">\n                <span class=\"grid h-8 w-8 place-items-center rounded-sm text-sm font-bold\" data-kid=\"1-1-1-1-1\" data-name=\"site logo icon\" style=\"background:var(--zt-blue);color:#fff\">\n                    Z\n                </span>\n                <span class=\"zt-brand-word text-lg font-bold tracking-tight\" data-kid=\"1-1-1-1-2\" data-name=\"site name text\">\n                    ZeeTeach\n                </span>\n            </a>\n            <nav aria-label=\"Indian Economic Development\" class=\"flex items-center gap-1\" data-kid=\"1-1-1-2\" data-name=\"navigation menu\">\n                <a aria-current=\"page\" class=\"zt-focus rounded-sm px-4 py-3 text-sm font-semibold no-underline\" data-kid=\"1-1-1-2-1\" data-name=\"active navigation link\" href=\"#deck\" style=\"color:var(--zt-ink);background:var(--zt-blue-soft);box-shadow:inset 0 -2px 0 var(--zt-blue)\">\n                    Presentation\n                </a>\n                <a class=\"zt-focus rounded-sm px-4 py-3 text-sm no-underline\" data-kid=\"1-1-1-2-2\" data-name=\"inactive navigation link\" href=\"/study-guide\" style=\"color:var(--zt-muted)\">\n                    Study guide\n                </a>\n                <a class=\"zt-focus rounded-sm px-4 py-3 text-sm no-underline\" data-kid=\"1-1-1-2-3\" data-name=\"inactive navigation link\" href=\"/quiz\" style=\"color:var(--zt-muted)\">\n                    Quiz\n                </a>\n            </nav>\n            <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-1-3\" data-name=\"header actions container\">\n                <span class=\"zt-nav-label text-xs\" data-kid=\"1-1-1-3-1\" data-name=\"class details label\" style=\"color:var(--zt-muted)\">\n                    Class XI · Economics\n                </span>\n                <button aria-label=\"Switch to dark mode\" aria-pressed=\"false\" class=\"zt-focus zt-theme flex h-10 items-center gap-2 rounded-sm border px-3 text-xs font-semibold\" data-kid=\"1-1-1-3-2\" data-name=\"dark mode toggle button\" style=\"border-color:var(--zt-rule);color:var(--zt-ink);background:transparent\" type=\"button\">\n                    <span aria-hidden=\"true\" class=\"h-4 w-4 rounded-full border\" data-kid=\"1-1-1-3-2-1\" data-name=\"toggle status indicator\" style=\"border-color:var(--zt-muted)\">\n                    </span>\n                    <span class=\"zt-nav-label\" data-kid=\"1-1-1-3-2-2\" data-name=\"toggle label text\">\n                        Dark\n                    </span>\n                </button>\n            </div>\n        </div>\n    </header>\n    <main class=\"zt-shell mx-auto max-w-[1320px] px-8 pb-16\" data-kid=\"1-2\" data-name=\"main content area\">\n        <nav aria-label=\"Course path\" class=\"flex items-center gap-2 pt-6 text-xs\" data-kid=\"1-2-1\" data-name=\"breadcrumb navigation\" style=\"color:var(--zt-muted)\">\n            <a class=\"zt-focus underline underline-offset-4\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb link\" href=\"/commerce\">\n                Commerce\n            </a>\n            <span aria-hidden=\"true\" data-kid=\"1-2-1-2\" data-name=\"breadcrumb separator\">\n                /\n            </span>\n            <a class=\"zt-focus underline underline-offset-4\" data-kid=\"1-2-1-3\" data-name=\"breadcrumb link\" href=\"/commerce/economics\">\n                Economics\n            </a>\n            <span aria-hidden=\"true\" data-kid=\"1-2-1-4\" data-name=\"breadcrumb separator\">\n                /\n            </span>\n            <span aria-current=\"location\" data-kid=\"1-2-1-5\" data-name=\"current page breadcrumb label\" style=\"color:var(--zt-ink)\">\n                Indian Economic Development\n            </span>\n        </nav>\n        <section aria-labelledby=\"page-title\" class=\"zt-lesson-head mb-7 mt-5 flex flex-wrap items-end justify-between gap-5\" data-kid=\"1-2-2\" data-name=\"lesson header section\">\n            <div class=\"max-w-[710px]\" data-kid=\"1-2-2-1\" data-name=\"lesson header text container\">\n                <h1 class=\"zt-display mb-2 text-[42px] leading-[1.13]\" data-kid=\"1-2-2-1-1\" data-name=\"lesson headline\" id=\"page-title\">\n                    Understand the forces shaping India’s economy.\n                </h1>\n                <p class=\"mb-0 max-w-[680px] text-base leading-7\" data-kid=\"1-2-2-1-2\" data-name=\"lesson description text\" style=\"color:var(--zt-muted)\">\n                    A guided, visual presentation on India’s economic history, its major sectors, and the choices behind development.\n                </p>\n            </div>\n            <div class=\"mb-1 flex items-center gap-3 text-sm\" data-kid=\"1-2-2-2\" data-name=\"lesson metadata container\" style=\"color:var(--zt-muted)\">\n                <span class=\"zt-kicker\" data-kid=\"1-2-2-2-1\" data-name=\"slide count kicker\" style=\"color:var(--zt-blue)\">\n                    19-slide lesson\n                </span>\n                <span class=\"h-1 w-1 rounded-full\" data-kid=\"1-2-2-2-2\" data-name=\"metadata separator dot\" style=\"background:var(--zt-accent)\">\n                </span>\n                <span data-kid=\"1-2-2-2-3\" data-name=\"course year metadata\">\n                    Class XI · 2025\n                </span>\n            </div>\n        </section>\n        <section aria-label=\"Presentation and course context\" class=\"grid grid-cols-1 items-start gap-7 lg:grid-cols-[minmax(0,1.82fr)_minmax(300px,.9fr)]\" data-kid=\"1-2-3\" data-name=\"presentation and context section\">\n            <div class=\"min-w-0 scroll-mt-4\" data-kid=\"1-2-3-1\" data-name=\"presentation deck container\" id=\"deck\">\n                <div class=\"mb-3 flex items-center justify-between gap-4\" data-kid=\"1-2-3-1-1\" data-name=\"presentation header bar\">\n                    <h2 class=\"m-0 text-lg font-semibold\" data-kid=\"1-2-3-1-1-1\" data-name=\"presentation title\">\n                        Indian Economic Development\n                    </h2>\n                    <span class=\"tabular-nums text-sm font-semibold\" data-kid=\"1-2-3-1-1-2\" data-name=\"slide progress indicator\" style=\"color:var(--zt-blue)\">\n                        Slide\n                        <strong data-kid=\"1-2-3-1-1-2-1\" data-name=\"current slide number\">\n                            01\n                        </strong>\n                        <span data-kid=\"1-2-3-1-1-2-2\" data-name=\"total slide count\" style=\"color:var(--zt-muted)\">\n                            / 19\n                        </span>\n                    </span>\n                </div>\n                <div class=\"overflow-hidden border\" data-kid=\"1-2-3-1-2\" data-name=\"presentation slide container\" style=\"border-color:var(--zt-rule);background:var(--zt-paper)\">\n                    <div class=\"grid aspect-[16/10] grid-cols-[1.08fr_.92fr] md:grid-cols-[1.08fr_.92fr] max-md:grid-cols-1\" data-kid=\"1-2-3-1-2-1\" data-name=\"slide content layout\">\n                        <div class=\"zt-slide-art flex items-center justify-center p-6\" data-kid=\"1-2-3-1-2-1-1\" data-name=\"slide art background\" style=\"background:#e4ebed\">\n                            <img alt=\"Illustration of India's rural, industrial and urban economy\" class=\"h-full w-full object-contain\" data-kid=\"1-2-3-1-2-1-1-1\" data-name=\"slide illustration image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/cover-india-economy.svg\"/>\n                        </div>\n                        <div class=\"zt-slide-copy flex flex-col justify-center p-9\" data-kid=\"1-2-3-1-2-1-2\" data-name=\"slide copy content\" style=\"background:#173a4a;color:#f4f6f2\">\n                            <span class=\"zt-kicker mb-5\" data-kid=\"1-2-3-1-2-1-2-1\" data-name=\"slide kicker text\" style=\"color:#f0c76a\">\n                                A guided presentation · Class XI Economics · 2025\n                            </span>\n                            <h3 class=\"zt-display mb-4 text-[36px] leading-[1.12]\" data-kid=\"1-2-3-1-2-1-2-2\" data-name=\"slide headline\">\n                                Indian Economic Development\n                            </h3>\n                            <p class=\"mb-0 text-base leading-7\" data-kid=\"1-2-3-1-2-1-2-3\" data-name=\"slide body text\" style=\"color:#d1e0e0\">\n                                A guided presentation for Class XI Economics · 2025\n                            </p>\n                        </div>\n                    </div>\n                    <div class=\"flex min-h-[60px] items-center justify-between gap-4 border-t px-4 py-2\" data-kid=\"1-2-3-1-2-2\" data-name=\"slide control bar\" style=\"border-color:var(--zt-rule);background:var(--zt-paper)\">\n                        <button aria-label=\"Previous slide\" class=\"zt-focus min-h-11 rounded-sm border px-4 text-sm font-semibold\" data-kid=\"1-2-3-1-2-2-1\" data-name=\"previous slide button\" disabled=\"\" style=\"border-color:var(--zt-rule);color:var(--zt-muted);background:transparent\" type=\"button\">\n                            ←\n                            <span class=\"hidden sm:inline\" data-kid=\"1-2-3-1-2-2-1-1\" data-name=\"previous button label\">\n                                Previous\n                            </span>\n                        </button>\n                        <p class=\"m-0 text-sm tabular-nums\" data-kid=\"1-2-3-1-2-2-2\" data-name=\"slide progress text\" style=\"color:var(--zt-muted)\">\n                            <strong data-kid=\"1-2-3-1-2-2-2-1\" data-name=\"current slide number text\" style=\"color:var(--zt-ink)\">\n                                1\n                            </strong>\n                            of 19\n                        </p>\n                        <button aria-label=\"Next slide\" class=\"zt-focus min-h-11 rounded-sm border px-4 text-sm font-semibold\" data-kid=\"1-2-3-1-2-2-3\" data-name=\"next slide button\" style=\"border-color:var(--zt-blue);color:#fff;background:var(--zt-blue)\" type=\"button\">\n                            <span class=\"hidden sm:inline\" data-kid=\"1-2-3-1-2-2-3-1\" data-name=\"next button label\">\n                                Next\n                            </span>\n                            →\n                        </button>\n                    </div>\n                    <div aria-label=\"Choose a slide\" class=\"grid grid-cols-10 gap-1.5 px-4 py-3 max-sm:grid-cols-5\" data-kid=\"1-2-3-1-2-3\" data-name=\"slide navigation grid\">\n                        <button aria-current=\"step\" aria-label=\"Go to slide 1: Indian Economic Development\" class=\"zt-focus min-h-10 rounded-sm text-xs font-bold\" data-kid=\"1-2-3-1-2-3-1\" data-name=\"active slide thumbnail\" style=\"color:#fff;background:var(--zt-blue)\">\n                            01\n                        </button>\n                        <button aria-label=\"Go to slide 2\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-2\" data-name=\"inactive slide thumbnail\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            02\n                        </button>\n                        <button aria-label=\"Go to slide 3\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-3\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            03\n                        </button>\n                        <button aria-label=\"Go to slide 4\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-4\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            04\n                        </button>\n                        <button aria-label=\"Go to slide 5\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-5\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            05\n                        </button>\n                        <button aria-label=\"Go to slide 6\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-6\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            06\n                        </button>\n                        <button aria-label=\"Go to slide 7\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-7\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            07\n                        </button>\n                        <button aria-label=\"Go to slide 8\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-8\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            08\n                        </button>\n                        <button aria-label=\"Go to slide 9\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-9\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            09\n                        </button>\n                        <button aria-label=\"Go to slide 10\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-10\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            10\n                        </button>\n                        <button aria-label=\"Go to slide 11\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-11\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            11\n                        </button>\n                        <button aria-label=\"Go to slide 12\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-12\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            12\n                        </button>\n                        <button aria-label=\"Go to slide 13\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-13\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            13\n                        </button>\n                        <button aria-label=\"Go to slide 14\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-14\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            14\n                        </button>\n                        <button aria-label=\"Go to slide 15\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-15\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            15\n                        </button>\n                        <button aria-label=\"Go to slide 16\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-16\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            16\n                        </button>\n                        <button aria-label=\"Go to slide 17\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-17\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            17\n                        </button>\n                        <button aria-label=\"Go to slide 18\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-18\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            18\n                        </button>\n                        <button aria-label=\"Go to slide 19\" class=\"zt-focus min-h-10 rounded-sm border text-xs\" data-kid=\"1-2-3-1-2-3-19\" style=\"color:var(--zt-ink);border-color:var(--zt-rule)\">\n                            19\n                        </button>\n                    </div>\n                </div>\n                <div aria-label=\"Presentation tools\" class=\"mt-3 flex flex-wrap items-center justify-end gap-2\" data-kid=\"1-2-3-1-3\" data-name=\"presentation action buttons\">\n                    <button class=\"zt-focus min-h-10 px-3 text-sm font-medium\" data-kid=\"1-2-3-1-3-1\" data-name=\"fullscreen button\" style=\"color:var(--zt-muted)\" type=\"button\">\n                        Fullscreen\n                    </button>\n                    <button class=\"zt-focus min-h-10 px-3 text-sm font-medium\" data-kid=\"1-2-3-1-3-2\" data-name=\"print button\" style=\"color:var(--zt-muted)\" type=\"button\">\n                        Print\n                    </button>\n                    <button class=\"zt-focus min-h-10 px-3 text-sm font-medium\" data-kid=\"1-2-3-1-3-3\" data-name=\"save slide button\" style=\"color:var(--zt-muted)\" type=\"button\">\n                        Save current slide\n                    </button>\n                    <button class=\"zt-focus min-h-10 px-3 text-sm font-medium\" data-kid=\"1-2-3-1-3-4\" data-name=\"share button\" style=\"color:var(--zt-muted)\" type=\"button\">\n                        Share\n                    </button>\n                </div>\n                <p class=\"mt-1 text-right text-xs\" data-kid=\"1-2-3-1-4\" data-name=\"keyboard shortcut hint\" style=\"color:var(--zt-muted)\">\n                    Use the arrow keys to move through the lesson. Press\n                    <kbd class=\"rounded-sm border px-1.5 py-0.5\" data-kid=\"1-2-3-1-4-1\" data-name=\"shortcut key label\" style=\"border-color:var(--zt-rule)\">\n                        F\n                    </kbd>\n                    for fullscreen.\n                </p>\n            </div>\n            <aside class=\"zt-course-aside min-w-0 border-t-2 pt-3\" data-kid=\"1-2-3-2\" data-name=\"course outline aside\" style=\"border-color:var(--zt-blue)\">\n                <h2 class=\"zt-display mb-2 text-[26px] leading-tight\" data-kid=\"1-2-3-2-1\" data-name=\"outline headline\">\n                    From economic history to today’s questions.\n                </h2>\n                <p class=\"mb-5 text-sm leading-6\" data-kid=\"1-2-3-2-2\" data-name=\"outline description\" style=\"color:var(--zt-muted)\">\n                    The lesson connects India’s past policy choices with the way people work, produce, trade, and live today.\n                </p>\n                <h3 class=\"zt-kicker mb-2\" data-kid=\"1-2-3-2-3\" data-name=\"outline section kicker\" style=\"color:var(--zt-blue)\">\n                    Course outline\n                </h3>\n                <ol class=\"m-0 list-none p-0\" data-kid=\"1-2-3-2-4\" data-name=\"outline list\">\n                    <li class=\"grid grid-cols-[42px_1fr] gap-3 border-t py-3\" data-kid=\"1-2-3-2-4-1\" data-name=\"outline item\" style=\"border-color:var(--zt-rule)\">\n                        <span class=\"zt-display text-xl\" data-kid=\"1-2-3-2-4-1-1\" data-name=\"outline step number\" style=\"color:var(--zt-accent)\">\n                            01\n                        </span>\n                        <div data-kid=\"1-2-3-2-4-1-2\" data-name=\"outline item content\">\n                            <strong class=\"text-sm\" data-kid=\"1-2-3-2-4-1-2-1\" data-name=\"outline item title\">\n                                History and reform\n                            </strong>\n                            <p class=\"mb-0 mt-1 text-xs leading-5\" data-kid=\"1-2-3-2-4-1-2-2\" data-name=\"outline item description\" style=\"color:var(--zt-muted)\">\n                                Colonial legacies, planned development, and the reforms that began in 1991.\n                            </p>\n                        </div>\n                    </li>\n                    <li class=\"grid grid-cols-[42px_1fr] gap-3 border-t py-3\" data-kid=\"1-2-3-2-4-2\" style=\"border-color:var(--zt-rule)\">\n                        <span class=\"zt-display text-xl\" data-kid=\"1-2-3-2-4-2-1\" style=\"color:var(--zt-accent)\">\n                            02\n                        </span>\n                        <div data-kid=\"1-2-3-2-4-2-2\">\n                            <strong class=\"text-sm\" data-kid=\"1-2-3-2-4-2-2-1\">\n                                Three connected sectors\n                            </strong>\n                            <p class=\"mb-0 mt-1 text-xs leading-5\" data-kid=\"1-2-3-2-4-2-2-2\" style=\"color:var(--zt-muted)\">\n                                Agriculture, industry, and services, and how each depends on the others.\n                            </p>\n                        </div>\n                    </li>\n                    <li class=\"grid grid-cols-[42px_1fr] gap-3 border-t py-3\" data-kid=\"1-2-3-2-4-3\" style=\"border-color:var(--zt-rule)\">\n                        <span class=\"zt-display text-xl\" data-kid=\"1-2-3-2-4-3-1\" style=\"color:var(--zt-accent)\">\n                            03\n                        </span>\n                        <div data-kid=\"1-2-3-2-4-3-2\">\n                            <strong class=\"text-sm\" data-kid=\"1-2-3-2-4-3-2-1\">\n                                Development in practice\n                            </strong>\n                            <p class=\"mb-0 mt-1 text-xs leading-5\" data-kid=\"1-2-3-2-4-3-2-2\" style=\"color:var(--zt-muted)\">\n                                Rural and urban change, public programmes, and sustainable growth.\n                            </p>\n                        </div>\n                    </li>\n                    <li class=\"grid grid-cols-[42px_1fr] gap-3 border-y py-3\" data-kid=\"1-2-3-2-4-4\" style=\"border-color:var(--zt-rule)\">\n                        <span class=\"zt-display text-xl\" data-kid=\"1-2-3-2-4-4-1\" style=\"color:var(--zt-accent)\">\n                            04\n                        </span>\n                        <div data-kid=\"1-2-3-2-4-4-2\">\n                            <strong class=\"text-sm\" data-kid=\"1-2-3-2-4-4-2-1\">\n                                India and the wider world\n                            </strong>\n                            <p class=\"mb-0 mt-1 text-xs leading-5\" data-kid=\"1-2-3-2-4-4-2-2\" style=\"color:var(--zt-muted)\">\n                                Trade, investment, and the country’s place in the global economy.\n                            </p>\n                        </div>\n                    </li>\n                </ol>\n                <div class=\"mt-5 grid grid-cols-2 gap-5\" data-kid=\"1-2-3-2-5\" data-name=\"aside utility links\">\n                    <a class=\"zt-focus border-b pb-3 no-underline\" data-kid=\"1-2-3-2-5-1\" data-name=\"study guide link\" href=\"/study-guide\" style=\"border-color:var(--zt-rule);color:var(--zt-ink)\">\n                        <span class=\"block text-sm font-bold\" data-kid=\"1-2-3-2-5-1-1\" data-name=\"study guide link text\">\n                            Study guide\n                            <span aria-hidden=\"true\" data-kid=\"1-2-3-2-5-1-1-1\" data-name=\"external link arrow icon\" style=\"color:var(--zt-accent)\">\n                                ↗\n                            </span>\n                        </span>\n                        <span class=\"mt-1 block text-xs\" data-kid=\"1-2-3-2-5-1-2\" data-name=\"study guide meta text\" style=\"color:var(--zt-muted)\">\n                            9 units · 40 marks\n                        </span>\n                    </a>\n                    <a class=\"zt-focus border-b pb-3 no-underline\" data-kid=\"1-2-3-2-5-2\" data-name=\"quiz link\" href=\"/quiz\" style=\"border-color:var(--zt-rule);color:var(--zt-ink)\">\n                        <span class=\"block text-sm font-bold\" data-kid=\"1-2-3-2-5-2-1\" data-name=\"quiz link text\">\n                            Quiz\n                            <span aria-hidden=\"true\" data-kid=\"1-2-3-2-5-2-1-1\" data-name=\"external link arrow icon\" style=\"color:var(--zt-accent)\">\n                                ↗\n                            </span>\n                        </span>\n                        <span class=\"mt-1 block text-xs\" data-kid=\"1-2-3-2-5-2-2\" data-name=\"quiz meta text\" style=\"color:var(--zt-muted)\">\n                            27 questions · 9 chapters\n                        </span>\n                    </a>\n                </div>\n            </aside>\n        </section>\n        <section aria-label=\"Study guide and quiz examples\" class=\"zt-bottom-grid mt-12 grid grid-cols-[1.05fr_.95fr] gap-6\" data-kid=\"1-2-4\" data-name=\"study guide and quiz section\">\n            <div class=\"min-w-0 border-t-2 pt-4\" data-kid=\"1-2-4-1\" data-name=\"unit weightage container\" style=\"border-color:var(--zt-blue)\">\n                <div class=\"mb-3 flex flex-wrap items-baseline justify-between gap-2\" data-kid=\"1-2-4-1-1\" data-name=\"unit weightage header\">\n                    <h2 class=\"zt-display m-0 text-[25px]\" data-kid=\"1-2-4-1-1-1\" data-name=\"unit weightage title\">\n                        Unit weightage\n                    </h2>\n                    <a class=\"zt-focus text-sm font-semibold underline underline-offset-4\" data-kid=\"1-2-4-1-1-2\" data-name=\"open study guide link\" href=\"/study-guide\" style=\"color:var(--zt-blue)\">\n                        Open all 9 units ↗\n                    </a>\n                </div>\n                <p class=\"mb-3 text-sm\" data-kid=\"1-2-4-1-2\" data-name=\"unit weightage description\" style=\"color:var(--zt-muted)\">\n                    Indian Economic Development · selected guide entries\n                </p>\n                <div class=\"overflow-x-auto\" data-kid=\"1-2-4-1-3\" data-name=\"weightage table container\">\n                    <table class=\"w-full border-collapse text-left text-sm\" data-kid=\"1-2-4-1-3-1\" data-name=\"weightage table\">\n                        <thead data-kid=\"1-2-4-1-3-1-1\" data-name=\"table head\">\n                            <tr class=\"text-xs font-semibold\" data-kid=\"1-2-4-1-3-1-1-1\" data-name=\"table header row\" style=\"color:var(--zt-muted)\">\n                                <th class=\"py-2 pr-3\" data-kid=\"1-2-4-1-3-1-1-1-1\" data-name=\"unit header\">\n                                    UNIT\n                                </th>\n                                <th class=\"py-2 pr-3\" data-kid=\"1-2-4-1-3-1-1-1-2\" data-name=\"chapter header\">\n                                    CHAPTER\n                                </th>\n                                <th class=\"py-2 pr-3 text-right\" data-kid=\"1-2-4-1-3-1-1-1-3\" data-name=\"periods header\">\n                                    PERIODS\n                                </th>\n                                <th class=\"py-2 text-right\" data-kid=\"1-2-4-1-3-1-1-1-4\" data-name=\"marks header\">\n                                    MARKS\n                                </th>\n                            </tr>\n                        </thead>\n                        <tbody data-kid=\"1-2-4-1-3-1-2\" data-name=\"table body\">\n                            <tr class=\"border-t\" data-kid=\"1-2-4-1-3-1-2-1\" data-name=\"table row\" style=\"border-color:var(--zt-rule)\">\n                                <td class=\"py-2.5 pr-3 font-semibold\" data-kid=\"1-2-4-1-3-1-2-1-1\" data-name=\"unit code cell\" style=\"color:var(--zt-accent)\">\n                                    IE 3\n                                </td>\n                                <td class=\"py-2.5 pr-3\" data-kid=\"1-2-4-1-3-1-2-1-2\" data-name=\"chapter title cell\">\n                                    Liberalisation, Privatisation and Globalisation\n                                </td>\n                                <td class=\"py-2.5 pr-3 text-right tabular-nums\" data-kid=\"1-2-4-1-3-1-2-1-3\" data-name=\"periods cell\">\n                                    18\n                                </td>\n                                <td class=\"py-2.5 text-right font-bold tabular-nums\" data-kid=\"1-2-4-1-3-1-2-1-4\" data-name=\"marks cell\">\n                                    6\n                                </td>\n                            </tr>\n                            <tr class=\"border-t\" data-kid=\"1-2-4-1-3-1-2-2\" style=\"border-color:var(--zt-rule)\">\n                                <td class=\"py-2.5 pr-3 font-semibold\" data-kid=\"1-2-4-1-3-1-2-2-1\" style=\"color:var(--zt-accent)\">\n                                    IE 4\n                                </td>\n                                <td class=\"py-2.5 pr-3\" data-kid=\"1-2-4-1-3-1-2-2-2\">\n                                    Poverty\n                                </td>\n                                <td class=\"py-2.5 pr-3 text-right tabular-nums\" data-kid=\"1-2-4-1-3-1-2-2-3\">\n                                    20\n                                </td>\n                                <td class=\"py-2.5 text-right font-bold tabular-nums\" data-kid=\"1-2-4-1-3-1-2-2-4\">\n                                    6\n                                </td>\n                            </tr>\n                            <tr class=\"border-y\" data-kid=\"1-2-4-1-3-1-2-3\" style=\"border-color:var(--zt-rule)\">\n                                <td class=\"py-2.5 pr-3 font-semibold\" data-kid=\"1-2-4-1-3-1-2-3-1\" style=\"color:var(--zt-accent)\">\n                                    IE 8\n                                </td>\n                                <td class=\"py-2.5 pr-3\" data-kid=\"1-2-4-1-3-1-2-3-2\">\n                                    Environment and Sustainable Development\n                                </td>\n                                <td class=\"py-2.5 pr-3 text-right tabular-nums\" data-kid=\"1-2-4-1-3-1-2-3-3\">\n                                    17\n                                </td>\n                                <td class=\"py-2.5 text-right font-bold tabular-nums\" data-kid=\"1-2-4-1-3-1-2-3-4\">\n                                    6\n                                </td>\n                            </tr>\n                        </tbody>\n                    </table>\n                </div>\n            </div>\n            <div class=\"min-w-0 border-t-2 pt-4\" data-kid=\"1-2-4-2\" data-name=\"answer evidence container\" style=\"border-color:var(--zt-accent)\">\n                <div class=\"mb-3 flex flex-wrap items-baseline justify-between gap-2\" data-kid=\"1-2-4-2-1\" data-name=\"evidence header\">\n                    <h2 class=\"zt-display m-0 text-[25px]\" data-kid=\"1-2-4-2-1-1\" data-name=\"evidence section title\">\n                        Answer with evidence\n                    </h2>\n                    <a class=\"zt-focus text-sm font-semibold underline underline-offset-4\" data-kid=\"1-2-4-2-1-2\" data-name=\"open quiz link\" href=\"/quiz\" style=\"color:var(--zt-blue)\">\n                        Open chapter quiz ↗\n                    </a>\n                </div>\n                <p class=\"mb-3 text-sm\" data-kid=\"1-2-4-2-2\" data-name=\"evidence section description\" style=\"color:var(--zt-muted)\">\n                    Quiz · IE 1 · Choose the best explanation\n                </p>\n                <p class=\"mb-3 text-base font-semibold leading-6\" data-kid=\"1-2-4-2-3\" data-name=\"quiz question text\">\n                    Which description best captures the colonial pattern of Indian foreign trade?\n                </p>\n                <div class=\"border-l-2 pl-4 py-2\" data-kid=\"1-2-4-2-4\" data-name=\"correct answer block\" style=\"border-color:var(--zt-good);background:var(--zt-paper-alt)\">\n                    <p class=\"zt-kicker mb-1\" data-kid=\"1-2-4-2-4-1\" data-name=\"correct answer label\" style=\"color:var(--zt-good)\">\n                        Correct answer\n                    </p>\n                    <p class=\"mb-1 text-sm font-semibold\" data-kid=\"1-2-4-2-4-2\" data-name=\"correct answer text\">\n                        India supplied primary products and imported many finished manufactured goods.\n                    </p>\n                    <p class=\"mb-0 text-sm leading-6\" data-kid=\"1-2-4-2-4-3\" data-name=\"correct answer explanation\" style=\"color:var(--zt-muted)\">\n                        The notes describe India as a supplier of primary products and a market for finished goods from Britain.\n                    </p>\n                </div>\n            </div>\n        </section>\n        <section class=\"mt-10 border-t pt-5\" data-kid=\"1-2-5\" data-name=\"footer call-to-action section\" style=\"border-color:var(--zt-rule)\">\n            <div class=\"flex flex-wrap items-center justify-between gap-4\" data-kid=\"1-2-5-1\" data-name=\"footer call-to-action content\">\n                <p class=\"zt-display m-0 text-xl\" data-kid=\"1-2-5-1-1\" data-name=\"footer call-to-action headline\">\n                    A clear route through the subject.\n                </p>\n                <div class=\"flex flex-wrap items-center gap-x-4 gap-y-2 text-sm\" data-kid=\"1-2-5-1-2\" data-name=\"footer utility links container\">\n                    <a class=\"zt-focus underline underline-offset-4\" data-kid=\"1-2-5-1-2-1\" data-name=\"footer study guide link\" href=\"/study-guide\" style=\"color:var(--zt-ink)\">\n                        Study guide · 9 units\n                    </a>\n                    <a class=\"zt-focus underline underline-offset-4\" data-kid=\"1-2-5-1-2-2\" data-name=\"footer quiz link\" href=\"/quiz\" style=\"color:var(--zt-ink)\">\n                        Chapter quiz · 27 questions\n                    </a>\n                </div>\n            </div>\n        </section>\n    </main>\n</div>\n",
