    "var_7413e9027c97": {
      "type": "variant",
      "label": "01 — Curriculum Route",
      "parentId": null,
      "themeId": null,
      "rect": {
        "x": 2760,
        "y": 0,
        "w": 1280,
        "h": 0
      },
      "html": "<style>\n    @import url(\"https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@3.48.0/dist/tabler-icons.min.css\");\n:root {\n  --paper: #f2eee5;\n  --paper-deep: #e7e1d5;\n  --paper-raised: #f8f5ee;\n  --ink: #202a25;\n  --muted: #60675f;\n  --forest: #273c31;\n  --forest-soft: #40594b;\n  --clay: #a55235;\n  --rule: #c9c2b5;\n  --serif: \"Palatino Linotype\", \"Book Antiqua\", Georgia, serif;\n  --sans: \"Trebuchet MS\", \"Segoe UI\", sans-serif;\n}\n:root[data-theme=\"dark\"] {\n  --paper: #191f1b;\n  --paper-deep: #222a25;\n  --paper-raised: #252e28;\n  --ink: #e8e6de;\n  --muted: #b0b8af;\n  --forest: #bdcfc0;\n  --forest-soft: #a6bdad;\n  --clay: #e0a184;\n  --rule: #48534b;\n}\n.lesson-slide { aspect-ratio: 16 / 10; }\n.slide-art { min-height: 0; }\n.course-route { position: relative; }\n.course-route::before { content: \"\"; position: absolute; left: 18px; top: 18px; bottom: 44px; width: 1px; background: var(--rule); }\n@media (max-width: 900px) {\n  .lesson-grid { grid-template-columns: minmax(0, 1fr); }\n  .lesson-aside { border-left: 0 !important; border-top: 1px solid var(--rule); padding: 28px 0 0 !important; }\n  .lesson-slide { aspect-ratio: 16 / 11; }\n}\n@media (max-width: 680px) {\n  .desktop-path { display: none !important; }\n  .mobile-path { display: flex !important; }\n  .topbar-inner { flex-wrap: wrap; gap: 8px 12px; padding-block: 11px; }\n  .mobile-path { width: 100%; order: 3; min-height: 30px; }\n  .route-inner { align-items: center; gap: 14px; }\n  .route-course-label { display: none !important; }\n  .route-tabs { width: 100%; justify-content: space-between; }\n  .main-wrap { padding-top: 27px !important; }\n  .lesson-intro { display: block !important; margin-bottom: 24px !important; }\n  .lesson-intro h1 { max-width: 100% !important; font-size: clamp(2rem, 8vw, 2.7rem) !important; }\n  .lesson-intro-meta { margin-top: 14px; }\n  .deck-heading { align-items: flex-end; }\n  .lesson-slide { aspect-ratio: 16 / 12; grid-template-columns: 1fr !important; }\n  .slide-art { height: 43vw; min-height: 170px; max-height: 260px; }\n  .slide-art img { object-position: center 58%; }\n  .slide-copy { padding: 23px 24px !important; }\n  .slide-copy h3 { max-width: 14ch !important; font-size: clamp(1.8rem, 8vw, 2.7rem) !important; }\n  .deck-actions { grid-template-columns: 1fr; }\n  .deck-tools { justify-content: flex-start !important; }\n  .deck-tools button { flex: 1 1 40%; }\n}\n</style>\n<div class=\"min-h-screen bg-[var(--paper)] font-[var(--sans)] text-[var(--ink)]\" data-kid=\"1\" data-name=\"page layout container\">\n    <header class=\"border-b border-[var(--rule)] bg-[var(--paper-raised)]\" data-kid=\"1-1\" data-name=\"header container\">\n        <div class=\"topbar-inner mx-auto flex min-h-[68px] max-w-[1360px] items-center justify-between gap-5 px-8 max-[680px]:px-5\" data-kid=\"1-1-1\" data-name=\"topbar content wrapper\">\n            <a aria-label=\"ZeeTeach home\" class=\"flex shrink-0 items-center gap-2.5 no-underline text-[var(--forest)]\" data-kid=\"1-1-1-1\" data-name=\"home navigation link\" href=\"#top\">\n                <span class=\"grid h-9 w-9 place-items-center rounded-xl bg-[var(--forest)] text-[var(--paper-raised)]\" data-kid=\"1-1-1-1-1\" data-name=\"book icon background wrapper\">\n                    <i aria-hidden=\"true\" class=\"ti ti-book-2 text-[20px] leading-none\" data-kid=\"1-1-1-1-1-1\" data-name=\"book icon\">\n                    </i>\n                </span>\n                <span class=\"font-[var(--serif)] text-[1.45rem] font-bold tracking-[-0.04em]\" data-kid=\"1-1-1-1-2\" data-name=\"brand name text\">\n                    ZeeTeach\n                </span>\n            </a>\n            <nav aria-label=\"Course location\" class=\"desktop-path flex min-w-0 items-center gap-3 text-[14px] text-[var(--muted)]\" data-kid=\"1-1-1-2\" data-name=\"desktop navigation path breadcrumbs\">\n                <a class=\"no-underline hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-1\" data-name=\"home link\" href=\"/\">\n                    Home\n                </a>\n                <i aria-hidden=\"true\" class=\"ti ti-chevron-right text-[15px]\" data-kid=\"1-1-1-2-2\" data-name=\"chevron icon\">\n                </i>\n                <span data-kid=\"1-1-1-2-3\" data-name=\"class name label\">\n                    Class XI\n                </span>\n                <i aria-hidden=\"true\" class=\"ti ti-chevron-right text-[15px]\" data-kid=\"1-1-1-2-4\" data-name=\"chevron icon\">\n                </i>\n                <a class=\"no-underline hover:text-[var(--ink)]\" data-kid=\"1-1-1-2-5\" data-name=\"subject link\" href=\"/commerce/economics\">\n                    Economics\n                </a>\n                <i aria-hidden=\"true\" class=\"ti ti-chevron-right text-[15px]\" data-kid=\"1-1-1-2-6\" data-name=\"chevron icon\">\n                </i>\n                <span class=\"font-semibold text-[var(--ink)]\" data-kid=\"1-1-1-2-7\" data-name=\"current page label\">\n                    Indian Economic Development\n                </span>\n            </nav>\n            <div class=\"flex shrink-0 items-center gap-2\" data-kid=\"1-1-1-3\" data-name=\"header right tools container\">\n                <button aria-label=\"Switch to dark mode\" aria-pressed=\"false\" class=\"flex min-h-10 items-center gap-2 rounded-full border border-[var(--rule)] bg-[var(--paper)] px-3.5 text-[13px] font-semibold text-[var(--ink)]\" data-kid=\"1-1-1-3-1\" data-name=\"dark mode switch button\" type=\"button\">\n                    <i aria-hidden=\"true\" class=\"ti ti-moon text-[17px]\" data-kid=\"1-1-1-3-1-1\" data-name=\"moon icon\">\n                    </i>\n                    <span data-kid=\"1-1-1-3-1-2\" data-name=\"dark mode button label\">\n                        Dark\n                    </span>\n                </button>\n            </div>\n            <nav aria-label=\"Course location\" class=\"mobile-path hidden items-center gap-2 overflow-x-auto text-[13px] text-[var(--muted)]\" data-kid=\"1-1-1-4\" data-name=\"mobile navigation path breadcrumbs\">\n                <a class=\"shrink-0 no-underline\" data-kid=\"1-1-1-4-1\" data-name=\"home link\" href=\"/\">\n                    Home\n                </a>\n                <i aria-hidden=\"true\" class=\"ti ti-chevron-right shrink-0 text-[14px]\" data-kid=\"1-1-1-4-2\" data-name=\"chevron icon\">\n                </i>\n                <span class=\"shrink-0\" data-kid=\"1-1-1-4-3\" data-name=\"course breadcrumb label\">\n                    Class XI · Economics\n                </span>\n                <i aria-hidden=\"true\" class=\"ti ti-chevron-right shrink-0 text-[14px]\" data-kid=\"1-1-1-4-4\" data-name=\"chevron icon\">\n                </i>\n                <span class=\"shrink-0 font-semibold text-[var(--ink)]\" data-kid=\"1-1-1-4-5\" data-name=\"current page label\">\n                    Indian Economic Development\n                </span>\n            </nav>\n        </div>\n    </header>\n    <div class=\"border-b border-[var(--rule)] bg-[var(--paper)]\" data-kid=\"1-2\" data-name=\"sub-header navigation bar\">\n        <div class=\"route-inner mx-auto flex min-h-[55px] max-w-[1360px] items-stretch justify-between px-8 max-[680px]:px-5\" data-kid=\"1-2-1\" data-name=\"breadcrumb and tab wrapper\">\n            <p class=\"route-course-label my-auto text-[13px] font-semibold text-[var(--muted)]\" data-kid=\"1-2-1-1\" data-name=\"breadcrumb path label\">\n                Class XI\n                <span class=\"px-1.5 text-[var(--rule)]\" data-kid=\"1-2-1-1-1\" data-name=\"slash separator\">\n                    /\n                </span>\n                Indian Economic Development\n            </p>\n            <nav aria-label=\"Chapter materials\" class=\"route-tabs flex items-stretch gap-8 text-[14px]\" data-kid=\"1-2-1-2\" data-name=\"chapter navigation tabs\">\n                <a aria-current=\"page\" class=\"flex items-center border-b-[3px] border-[var(--forest)] px-1 font-bold text-[var(--forest)] no-underline\" data-kid=\"1-2-1-2-1\" data-name=\"presentation tab link\" href=\"#deck\">\n                    Presentation\n                </a>\n                <a class=\"flex items-center border-b-[3px] border-transparent px-1 text-[var(--muted)] no-underline hover:border-[var(--rule)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-2-2\" data-name=\"study guide tab link\" href=\"/study-guide\">\n                    Study guide\n                </a>\n                <a class=\"flex items-center border-b-[3px] border-transparent px-1 text-[var(--muted)] no-underline hover:border-[var(--rule)] hover:text-[var(--ink)]\" data-kid=\"1-2-1-2-3\" data-name=\"quiz tab link\" href=\"/quiz\">\n                    Quiz\n                </a>\n            </nav>\n        </div>\n    </div>\n    <main class=\"main-wrap mx-auto max-w-[1360px] px-8 pb-14 pt-8 max-[680px]:px-5\" data-kid=\"1-3\" data-name=\"main page content area\" id=\"top\">\n        <section class=\"lesson-intro mb-7 flex items-end justify-between gap-8\" data-kid=\"1-3-1\" data-name=\"lesson introduction section\">\n            <div class=\"max-w-[760px]\" data-kid=\"1-3-1-1\" data-name=\"lesson title and description container\">\n                <h1 class=\"mb-2.5 max-w-[740px] font-[var(--serif)] text-[clamp(2.35rem,4vw,3.35rem)] leading-[1.02] tracking-[-0.045em] text-[var(--forest)]\" data-kid=\"1-3-1-1-1\" data-name=\"lesson main headline\">\n                    Understand the forces shaping India’s economy.\n                </h1>\n                <p class=\"mb-0 max-w-[690px] text-[16px] leading-[1.55] text-[var(--muted)]\" data-kid=\"1-3-1-1-2\" data-name=\"lesson overview text\">\n                    A guided, visual presentation on India’s economic history, its major sectors, and the choices behind development.\n                </p>\n            </div>\n            <div class=\"lesson-intro-meta mb-1 flex shrink-0 items-center gap-3 border-l border-[var(--rule)] pl-5 text-[14px] text-[var(--muted)] max-[680px]:border-l-0 max-[680px]:pl-0\" data-kid=\"1-3-1-2\" data-name=\"lesson meta info container\">\n                <span class=\"grid h-10 w-10 place-items-center rounded-full border border-[var(--rule)] text-[var(--clay)]\" data-kid=\"1-3-1-2-1\" data-name=\"presentation icon wrapper\">\n                    <i aria-hidden=\"true\" class=\"ti ti-presentation text-[19px]\" data-kid=\"1-3-1-2-1-1\" data-name=\"presentation icon\">\n                    </i>\n                </span>\n                <span data-kid=\"1-3-1-2-2\" data-name=\"lesson stats container\">\n                    <strong class=\"block text-[15px] text-[var(--ink)]\" data-kid=\"1-3-1-2-2-1\" data-name=\"total slides count\">\n                        19 slides\n                    </strong>\n                    <span data-kid=\"1-3-1-2-2-2\" data-name=\"stats description label\">\n                        For classroom discussion\n                    </span>\n                </span>\n            </div>\n        </section>\n        <div class=\"lesson-grid grid grid-cols-[minmax(0,2.65fr)_minmax(280px,0.95fr)] items-start gap-10\" data-kid=\"1-3-2\" data-name=\"deck and outline grid container\">\n            <section aria-labelledby=\"deck-heading\" class=\"min-w-0\" data-kid=\"1-3-2-1\" data-name=\"deck player section\" id=\"deck\">\n                <div class=\"deck-heading mb-3 flex min-h-[43px] items-center justify-between gap-4\" data-kid=\"1-3-2-1-1\" data-name=\"deck top bar\">\n                    <div class=\"min-w-0\" data-kid=\"1-3-2-1-1-1\" data-name=\"deck title container\">\n                        <h2 class=\"m-0 truncate font-[var(--serif)] text-[1.45rem] leading-tight tracking-[-0.025em] text-[var(--ink)]\" data-kid=\"1-3-2-1-1-1-1\" data-name=\"deck title\" id=\"deck-heading\">\n                            Indian Economic Development\n                        </h2>\n                    </div>\n                    <span class=\"shrink-0 font-[var(--serif)] text-[1.05rem] tabular-nums text-[var(--forest)]\" data-kid=\"1-3-2-1-1-2\" data-name=\"slide numbering container\">\n                        <strong data-kid=\"1-3-2-1-1-2-1\" data-name=\"current slide number\">\n                            01\n                        </strong>\n                        <span class=\"px-1.5 text-[var(--muted)]\" data-kid=\"1-3-2-1-1-2-2\" data-name=\"separator text\">\n                            of\n                        </span>\n                        19\n                    </span>\n                </div>\n                <div class=\"overflow-hidden rounded-[15px] border border-[var(--forest)]/20 bg-[var(--forest)] shadow-[0_18px_42px_rgba(39,60,49,0.12)]\" data-kid=\"1-3-2-1-2\" data-name=\"slide presentation wrapper\">\n                    <div class=\"lesson-slide grid grid-cols-[1.16fr_0.84fr] overflow-hidden\" data-kid=\"1-3-2-1-2-1\" data-name=\"slide content layout\">\n                        <div class=\"slide-art relative overflow-hidden bg-[#d9edf0]\" data-kid=\"1-3-2-1-2-1-1\" data-name=\"slide image artwork container\">\n                            <img alt=\"Fields, a factory, renewable energy, transport, and a growing Indian city\" class=\"absolute inset-0 h-full w-full object-cover object-center\" data-kid=\"1-3-2-1-2-1-1-1\" data-name=\"slide background image\" decoding=\"async\" loading=\"lazy\" src=\"/api/local/images/assets/cover-india-economy.svg\"/>\n                            <span class=\"absolute bottom-4 left-4 flex items-center gap-2 rounded-full bg-[var(--paper-raised)]/90 px-3 py-1.5 text-[12px] font-bold text-[var(--forest)] shadow-sm\" data-kid=\"1-3-2-1-2-1-1-2\" data-name=\"slide category label\">\n                                <span class=\"h-2 w-2 rounded-full bg-[var(--clay)]\" data-kid=\"1-3-2-1-2-1-1-2-1\" data-name=\"category indicator dot\">\n                                </span>\n                                India’s changing economy\n                            </span>\n                        </div>\n                        <div class=\"slide-copy relative flex flex-col justify-center px-8 py-10 text-[var(--paper-raised)]\" data-kid=\"1-3-2-1-2-1-2\" data-name=\"slide text content\">\n                            <div class=\"absolute right-5 top-5 flex h-9 w-9 items-center justify-center rounded-full border border-white/25 text-[12px] font-bold tabular-nums text-[#e0c39d]\" data-kid=\"1-3-2-1-2-1-2-1\" data-name=\"slide number badge\">\n                                01\n                            </div>\n                            <p class=\"mb-4 text-[13px] font-semibold text-[#e0c39d]\" data-kid=\"1-3-2-1-2-1-2-2\" data-name=\"slide metadata label\">\n                                Class XI Economics · 2025\n                            </p>\n                            <h3 class=\"mb-4 max-w-[11ch] font-[var(--serif)] text-[clamp(2rem,3.3vw,3.25rem)] leading-[0.98] tracking-[-0.045em]\" data-kid=\"1-3-2-1-2-1-2-3\" data-name=\"slide headline\">\n                                Indian Economic Development\n                            </h3>\n                            <p class=\"mb-0 max-w-[28ch] text-[15px] leading-[1.55] text-[#e5e6db]\" data-kid=\"1-3-2-1-2-1-2-4\" data-name=\"slide sub-description text\">\n                                A guided presentation for Class XI Economics · 2025\n                            </p>\n                            <div class=\"mt-7 flex items-center gap-3 text-[13px] text-[#e5e6db]\" data-kid=\"1-3-2-1-2-1-2-5\" data-name=\"slide themes separator\">\n                                <span class=\"h-px w-8 bg-[#d6ab81]\" data-kid=\"1-3-2-1-2-1-2-5-1\" data-name=\"themes line separator\">\n                                </span>\n                                Economic history · sectors · development\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"flex min-h-[58px] ite